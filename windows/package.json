{
  "name": "oanarina-archi-tool",
  "productName": "Oanarina Archi Tool",
  "version": "0.1.0",
  "description": "Oanarina Archi Tool for Windows: Electron shell around the archi-engine (ArchiCore).",
  "license": "GPL-3.0-or-later",
  "author": "Oana Rinaldi",
  "homepage": "https://www.oanarinaldi.com",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "gen": "node tools/gen-ui-data.mjs",
    "build": "node tools/gen-ui-data.mjs && node build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "start": "npm run build && electron .",
    "web": "node tools/gen-ui-data.mjs && node build.mjs --web",
    "test:ui": "node tools/gen-ui-data.mjs && node build.mjs --web && node test/ui-snapshots.mjs",
    "test:rpc": "node test/rpc-smoke.mjs"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "playwright-core": "^1.48.0",
    "@types/node": "^22.9.0"
  },
  "dependencies": {
    "lucide": "^0.460.0"
  }
}
